NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
DATABASE_URL="postgresql://user:password@localhost:5432/citycare?schema=public"

# optional, caching and rate limiting use redis when this is set
REDIS_URL="redis://default:password@localhost:6379"

JWT_ACCESS_SECRET="a-long-random-string-of-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN=1h
REFRESH_TOKEN_DAYS=30
BCRYPT_SALT_ROUNDS=10

# how many active complaints one staff member can hold
MAX_ACTIVE_ASSIGNMENTS=5

# a resolved complaint can be reopened within this many days, and this many times
REOPEN_WINDOW_DAYS=7
MAX_REOPENS=2

# stripe test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
PAYMENT_CURRENCY=usd

# base URL of the frontend, used for the payment and google login redirects
CLIENT_URL=http://localhost:3000

# comma separated list of allowed origins, empty means every origin
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
