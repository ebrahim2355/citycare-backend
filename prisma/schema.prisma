generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITIZEN
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  password     String?
  role         Role         @default(CITIZEN)
  status       UserStatus   @default(ACTIVE)
  provider     AuthProvider @default(LOCAL)
  googleId     String?      @unique
  phone        String?
  address      String?
  avatarUrl    String?
  departmentId String?
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department         Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  complaints         Complaint[]       @relation("CitizenComplaints")
  assignedComplaints Complaint[]       @relation("AssignedComplaints")
  complaintUpdates   ComplaintUpdate[]
  feedbacks          Feedback[]

  @@index([role, status])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum CategoryType {
  COMPLAINT
  SERVICE
}

model Department {
  id           String    @id @default(uuid())
  name         String    @unique
  description  String?
  contactEmail String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  categories Category[]
  staff      User[]
  complaints Complaint[]

  @@index([deletedAt])
  @@map("departments")
}

model Category {
  id           String       @id @default(uuid())
  name         String       @unique
  description  String?
  type         CategoryType @default(COMPLAINT)
  fee          Decimal      @default(0) @db.Decimal(10, 2)
  slaHours     Int          @default(72)
  isActive     Boolean      @default(true)
  departmentId String
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  complaints Complaint[]

  @@index([departmentId])
  @@index([type, isActive])
  @@index([deletedAt])
  @@map("categories")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  PENDING_PAYMENT
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
  CANCELLED
}

enum ComplaintPaymentStatus {
  NOT_REQUIRED
  UNPAID
  PAID
  REFUNDED
}

model Complaint {
  id              String                 @id @default(uuid())
  trackingCode    String                 @unique
  title           String
  description     String
  type            CategoryType
  priority        Priority               @default(MEDIUM)
  status          ComplaintStatus        @default(SUBMITTED)
  address         String
  area            String
  latitude        Float?
  longitude       Float?
  fee             Decimal                @default(0) @db.Decimal(10, 2)
  paymentStatus   ComplaintPaymentStatus @default(NOT_REQUIRED)
  citizenId       String
  categoryId      String
  departmentId    String
  assignedStaffId String?
  submittedAt     DateTime?
  assignedAt      DateTime?
  dueAt           DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  resolutionNote  String?
  rejectionReason String?
  reopenCount     Int                    @default(0)
  deletedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  citizen       User              @relation("CitizenComplaints", fields: [citizenId], references: [id], onDelete: Restrict)
  assignedStaff User?             @relation("AssignedComplaints", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department    Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  updates       ComplaintUpdate[]
  feedback      Feedback?

  @@index([citizenId, status])
  @@index([assignedStaffId, status])
  @@index([departmentId, status])
  @@index([categoryId])
  @@index([status, dueAt])
  @@index([area])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("complaints")
}

model ComplaintUpdate {
  id          String           @id @default(uuid())
  complaintId String
  actorId     String?
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus
  note        String?
  createdAt   DateTime         @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([complaintId, createdAt])
  @@map("complaint_updates")
}

model Feedback {
  id          String   @id @default(uuid())
  complaintId String   @unique
  citizenId   String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  citizen   User      @relation(fields: [citizenId], references: [id], onDelete: Restrict)

  @@index([citizenId])
  @@index([rating])
  @@map("feedbacks")
}
