{
    "name": "citycare-backend",
    "version": "1.0.0",
    "description": "Backend API for a city complaint and service request platform",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsup",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome format --write ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dotenv": "^18.0.7",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "24",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
