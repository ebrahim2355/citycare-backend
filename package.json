{
    "name": "citycare-backend",
    "version": "1.0.0",
    "description": "Backend API for a city complaint and service request platform",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsup",
        "start": "node dist/server.js",
        "postinstall": "prisma generate",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome format --write .",
        "migrate": "prisma migrate dev",
        "migrate:deploy": "prisma migrate deploy"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "@prisma/adapter-pg": "7.10.0",
        "@prisma/client": "7.10.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^18.0.7",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.1",
        "rate-limit-redis": "^6.0.1",
        "stripe": "^23.0.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "24",
        "@types/pg": "^8.23.1",
        "prisma": "7.10.0",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
